# Archivo de ejecución FUERA del checkout: /etc/cooper/.env, modo 0600.
COMPOSE_PROJECT_NAME=cooper
COOPER_IMAGE=localhost/cooper:inicial
DATA_ROOT=/var/lib/cooper
STATE_ROOT=/var/lib/cooper-operacion
COOPER_DOMAIN=cooper.example.com
N8N_DOMAIN=flujos.example.com
COOPER_ORIGIN=https://cooper.example.com
N8N_EDITOR_ORIGIN=https://flujos.example.com:8443
CADDY_TLS=operador@example.com
PUBLIC_BIND=0.0.0.0
HTTP_PORT=80
HTTPS_PORT=443
EDITOR_PORT=8443
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
COOPER_ADMIN_EMAIL=walter@example.com
COOPER_N8N_TOKEN=
COOPER_WEBHOOK_SECRET=
N8N_ENCRYPTION_KEY=
N8N_RUNNERS_AUTH_TOKEN=
# Valores de producción: n8n y medios decididos por Walter.
COOPER_FABRICA=n8n
COOPER_AVATAR=simulada
COOPER_VOZ_CLONADA=simulada
COOPER_VOZ_CATALOGO=simulada
COOPER_TRANSCRIPCION=simulada
HEYGEN_API_KEY=
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
COOPER_GASTO_ALERTA_USD=25
# Repositorio remoto cifrado; clave de restic separada del servidor/repo.
RESTIC_REPOSITORY=sftp:backup:/srv/copias/cooper
RESTIC_PASSWORD_FILE=/etc/cooper/restic-password
# SSH necesita clave dedicada y known_hosts verificado; nunca StrictHostKeyChecking=no.

# Integración final: activar servicios reales solo tras configurar/ensayar.
COOPER_CHAT=simulada
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
COOPER_CHAT_MODELO_CLAUDE=claude-sonnet-5-5
COOPER_CHAT_MODELO_OPENAI=gpt-6.1-sol
COOPER_MENSAJERIA=simulada
COOPER_MENSAJERIA_PAUSA=0
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Requiere puente/túnel dentro del espacio de red de n8n; nunca público.
PUENTE_CODEX_URL=http://127.0.0.1:8789
PUENTE_CODEX_TOKEN=
