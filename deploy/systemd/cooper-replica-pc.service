[Unit]
Description=Copia cifrada de Cooper fuera del VPS y restauración en PC
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 %h/.local/lib/cooper/operacion/replicar-pc.py --confirmar-vps
UMask=0077
TimeoutStartSec=2h
Nice=10
NoNewPrivileges=yes
# PrivateTmp en servicios de usuario crea un mapa UID limitado: restic no puede
# restaurar metadatos del UID 1001 del VPS. Los temporales ya son privados 0700.
