      "parameters": {
        "jsCode": "const expected = $('Validate Video Row').first().json.video_id;\nconst stored = $input.first().json.video_id === expected;\nreturn [{ json: stored\n  ? { httpStatus: 201, receipt: 'registered', video_id: expected }\n  : { httpStatus: 503, receipt: 'spreadsheet_write_unconfirmed' } }];"
      },
