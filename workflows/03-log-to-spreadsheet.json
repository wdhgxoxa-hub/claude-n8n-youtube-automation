      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst row = input.body ?? {};\nconst { video_id, title, description } = row;\nif (typeof video_id !== 'string' || !/^[A-Za-z0-9_-]{1,128}$/.test(video_id)\n    || typeof title !== 'string' || !title.trim() || title.length > 100 || /[<>]/.test(title)\n    || typeof description !== 'string' || Buffer.byteLength(description, 'utf8') > 5000 || /[<>]/.test(description)) {\n  return [{ json: { httpStatus: 400, receipt: 'invalid_video_metadata' } }];\n}\nif (!/^[A-Za-z0-9_-]{20,}$/.test(input.spreadsheetId) || input.spreadsheetId.startsWith('__YOUR_')) {\n  return [{ json: { httpStatus: 503, receipt: 'spreadsheet_not_configured' } }];\n}\n\nreturn [{ json: { httpStatus: 200, video_id, title, description, status: 'generating', created_at: new Date().toISOString() } }];"
      },
      "id": "b3fba972-ba6d-4bfe-ad7a-a481632ddae0",
      "name": "Validate Video Row",
      "type": "n8n-nodes-base.code",
