      "name": "Find Video Row",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        960,
        -112
      ],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const video = $('Validate Video Row').first().json;\nconst matches = $input.all().filter(({ json }) => json.video_id === video.video_id);\nif (matches.length > 1) return [{ json: { httpStatus: 409, receipt: 'duplicate_video_id' } }];\nif (matches.length === 1) return [{ json: { httpStatus: 200, receipt: 'already_registered', video_id: video.video_id } }];\nreturn [{ json: { ...video, shouldAppend: true } }];"
      },
      "id": "b4f8d4cc-c9b1-4564-96ab-cd39f749dfa8",
