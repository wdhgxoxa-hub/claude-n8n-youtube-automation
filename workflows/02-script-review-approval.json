    {
      "parameters": {
        "jsCode": "const decision = $input.first().json;\nconst review = $('Prepare Review').first().json;\nconst { allowClaude, claudeRoutineUrl } = $('Factory Settings').first().json;\nconst reply = (message) => [{ json: { callClaude: false, chatId: review.chatId, reply: message } }];\nif (decision.Decision === 'Abort') return reply('Revisión cancelada. ' + review.job.title);\nif (!['Approve', 'Request changes'].includes(decision.Decision)) {\n  return reply('La revisión venció o quedó sin decisión. ' + review.job.title);\n}\n\nconst revise = decision.Decision === 'Request changes';\nconst notes = typeof decision.Feedback === 'string' ? decision.Feedback.trim() : '';\nif (revise && (!notes || notes.length > 2000)) {\n  return reply('Los cambios requieren comentarios de 1 a 2000 caracteres. Solicita una nueva revisión.');\n}\nconst payload = { ...review.job, mode: revise ? 'revise' : 'approved' };\nif (revise) {\n  payload.revision += 1;\n  payload.notes = notes;\n}\nconst callClaude = allowClaude === true\n  && /^https:\\/\\/api\\.anthropic\\.com\\/v1\\/claude_code\\/routines\\/trig_[A-Za-z0-9_-]+\\/fire$/.test(claudeRoutineUrl);\nconst summary = (revise ? 'Cambios solicitados. ' : 'Guion aprobado. ') + review.job.title;\nreturn [{ json: { callClaude, chatId: review.chatId, payload, reply: callClaude ? summary : 'Modo de prueba. ' + summary } }];"
      },
