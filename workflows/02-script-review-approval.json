      "id": "893dbf82-6b23-48e2-a50e-2d90b5bc7215",
      "name": "Factory Settings",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst job = input.body ?? {};\nconst reject = (httpStatus, receipt) => [{ json: { httpStatus, receipt } }];\nif (!/^[1-9]\\d*$/.test(input.telegramChatId)) return reject(503, 'review_not_configured');\n\nconst { script, title, description, revision = 0 } = job;\nif (typeof script !== 'string' || !script.trim() || script.length > 45000\n    || typeof title !== 'string' || !title.trim() || title.length > 100 || /[<>]/.test(title)\n    || typeof description !== 'string' || Buffer.byteLength(description, 'utf8') > 5000 || /[<>]/.test(description)\n    || !Number.isSafeInteger(revision) || revision < 0) {\n  return reject(400, 'invalid_script_metadata');\n}\nconst topic = typeof job.topic === 'string' ? job.topic.slice(0, 600) : '';\nconst angle = typeof job.angle === 'string' ? job.angle.slice(0, 600) : '';\nconst cta = typeof job.cta === 'string' ? job.cta.slice(0, 600) : '';\nconst keywords = Array.isArray(job.keywords_used)\n  ? job.keywords_used.filter((word) => typeof word === 'string').slice(0, 10).map((word) => word.slice(0, 80))\n  : [];\nconst escape = (value) => value.replaceAll('&', '&amp;').replaceAll('<', '&lt;').replaceAll('>', '&gt;');\nconst formHtml = 'Revisión ' + revision + '\\n\\n<strong>Guion completo</strong>\\n'\n  + escape(script) + '\\n\\n<strong>Descripción de YouTube</strong>\\n' + escape(description);\nreturn [{ json: {\n  httpStatus: 200,\n  receipt: 'review_requested',\n  chatId: input.telegramChatId,\n  formHtml,\n  job: { title, description, script, revision, topic, angle, cta, keywords_used: keywords },\n} }];"
      },
      "id": "91e26620-5f5e-4d9c-b156-9b4a3f0c4370",
      "name": "Prepare Review",
