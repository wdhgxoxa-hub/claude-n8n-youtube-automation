[{"updatedAt":"2026-11-19T16:45:42.515Z","createdAt":"2026-11-19T09:04:55.432Z","id":"jylyhP7MsjovYWUC","name":"01 · Fábrica de videos · Telegram","description":null,"active":true,"isArchived":false,"nodes":[{"parameters":{"updates":["message"],"additionalFields":{}},"id":"d1360b64-af38-4fb9-a295-b38a48687999","name":"Telegram Trigger","type":"n8n-nodes-base.telegramTrigger","typeVersion":1.5,"position":[0,0],"webhookId":"be623ff7-244f-46c8-a4bf-4f4281fbdc81","credentials":{"telegramApi":{"id":"MOSawTRQa5BzV3pt","name":"Telegram account"}}},{"parameters":{"assignments":{"assignments":[{"id":"a474baf3-6028-4194-b4f3-dee76bad821a","name":"telegramChatId","value":"8667738444","type":"string"},{"id":"f5b1aecb-44b1-4113-ad8c-0e5cd5608e88","name":"claudeRoutineUrl","value":"https://api.anthropic.com/v1/claude_code/routines/trig_01RyeTY2hJtwhs5PCFWXxZTA/fire","type":"string"},{"id":"6bd28812-77e0-42e5-ac29-8e5ff1434e51","name":"allowClaude","value":true,"type":"boolean"}]},"includeOtherFields":true,"options":{}},"id":"7921c8ad-b3bf-43f2-a86b-fca348e6b3a7","name":"Factory Settings","type":"n8n-nodes-base.set","typeVersion":3.4,"position":[240,0]},{"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":1},"conditions":[{"id":"9caf11f4-5be7-44f7-97e4-cee375605d7c","leftValue":"={{ $json.message?.chat?.type === 'private' && /^[1-9]\\d*$/.test($json.telegramChatId) && String($json.message.chat.id) === $json.telegramChatId && String($json.message.from?.id) === $json.telegramChatId }}","rightValue":"","operator":{"type":"boolean","operation":"true","singleValue":true}}],"combinator":"and"},"options":{}},"id":"01acba6a-ccf1-4fde-935b-26cc29ebb877","name":"Is It Me?","type":"n8n-nodes-base.if","typeVersion":2,"position":[480,0]},{"parameters":{"jsCode":"const input = $input.first().json;\nconst text = typeof input.message.text === 'string' ? input.message.text.trim() : '';\nconst command = text.toLowerCase();\nconst state = $getWorkflowStaticData('global');\nconst reply = (message) => [{ json: { callClaude: false, reply: message, chatId: input.telegramChatId } }];\n\nif (Number.isInteger(input.update_id)) {\n  if (state.lastUpdate === input.update_id) return [];\n  state.lastUpdate = input.update_id;\n}\n\n// Fábrica v2: canal, video y estado van al orquestador nuevo.\nconst v2 = (j) => [{ json: { ...j, salidaV2: j.salidaV2, chatId: input.telegramChatId } }];\n{\n  const m = text.match(/^canal\\b[:\\s]*(.*)$/is);\n  if (m) { state.pending = null; return v2({ salidaV2: 1, evento: 'nuevo_canal', criterios: m[1].trim().slice(0, 1000), rechazos: [] }); }\n  const v = text.match(/^video\\s+([a-z0-9-]+)\\s*\\|\\s*(.+)$/is);\n  if (v) {\n    state.pending = null;\n    const short = /\\(short\\)\\s*$/i.test(v[2]);\n    const vidiq = /\\(use vidiq\\)/i.test(v[2]) ? 'use' : 'skip';\n    const tema = v[2].replace(/\\((short|use vidiq)\\)/ig, '').trim().slice(0, 500);\n    return v2({ salidaV2: 1, evento: 'nuevo_video', canal_id: v[1].toLowerCase(), tema, formato: short ? 'short' : '', vidiq });\n  }\n  if (/^video\\b/i.test(text)) return reply('Formato: video <id-del-canal> | <tema>. Agrega (short) para un Short.');\n  if (command === 'estado') { state.pending = null; return v2({ salidaV2: 2 }); }\n  const rp = command.match(/^reporte(?:\\s+(\\d{1,3}))?$/);\n  if (rp) { state.pending = null; return v2({ salidaV2: 2, tipo: 'reporte', dias: Number(rp[1] || 30) }); }\n  const cx = text.match(/^conectar\\s+([a-z0-9-]+)\\s*$/i);\n  if (cx) { state.pending = null; return v2({ salidaV2: 4, accion: 'enlace', canal_id: cx[1].toLowerCase() }); }\n  if (/^conectar\\b/i.test(text)) return reply('Formato: conectar <id-del-canal>');\n  const rf = text.match(/^referencias\\s+([a-z0-9-]+)\\s*$/i);\n  if (rf) { state.pending = null; return v2({ salidaV2: 1, evento: 'referencias', canal_id: rf[1].toLowerCase() }); }\n}\nif (!text) return reply('Envía texto. Escribe topic para una idea o script para un guion.');\nif (['cancel', 'stop', 'reset', 'cancelar'].includes(command)) {\n  state.pending = null;\n  return reply('Solicitud cancelada. Puedes iniciar otra con topic o script.');\n}\nif (['topic', 'idea'].includes(command)) {\n  state.pending = 'topic';\n  return reply('Envíame el tema. Puedes incluir [angle: ...], [cta: ...] y (use vidiq) si autorizas esa consulta.');\n}\nif (['script', 'guion', 'guión'].includes(command)) {\n  state.pending = 'script';\n  return reply('Envía tu guion final en un mensaje. Ese guion cuenta como aprobado cuando la producción esté habilitada.');\n}\nif (!['topic', 'script'].includes(state.pending)) {\n  // Todo lo demás lo atiende el agente de la fábrica (corregir, programar, ajustar la biblia, preguntas…).\n  return v2({ salidaV2: 3, texto: text.slice(0, 4000) });\n}\n\nconst mode = state.pending;\nlet payload = { mode, script: text };\nif (mode === 'topic') {\n  const researchFlag = text.match(/\\((use|no|skip)\\s+vidiq\\)\\s*$/i);\n  const idea = text.replace(/\\((use|no|skip)\\s+vidiq\\)\\s*$/i, '');\n  const angle = idea.match(/\\[angle:\\s*([^\\]]+)\\]/i)?.[1].trim() ?? '';\n  const cta = idea.match(/\\[cta:\\s*([^\\]]+)\\]/i)?.[1].trim() ?? '';\n  const topic = idea.replace(/\\[(angle|cta):[^\\]]+\\]/gi, '').trim();\n  if (!topic) return reply('Envía el tema junto con sus opciones.');\n  payload = { mode, topic, angle, cta, vidiq: researchFlag?.[1].toLowerCase() === 'use' ? 'use' : 'skip' };\n}\nstate.pending = null;\nconst callClaude = input.allowClaude === true\n  && /^https:\\/\\/api\\.anthropic\\.com\\/v1\\/claude_code\\/routines\\/trig_[A-Za-z0-9_-]+\\/fire$/.test(input.claudeRoutineUrl);\nreturn [{ json: {\n  chatId: input.telegramChatId,\n  callClaude,\n  payload,\n  reply: callClaude ? 'Recibido. Claude ya tiene tu solicitud.' : 'Modo de prueba. Registré tu solicitud localmente.',\n} }];"},"id":"cb366970-cd47-48ad-9f26-f97f3e826665","name":"Conversation Router","type":"n8n-nodes-base.code","typeVersion":2,"position":[720,0]},{"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":1},"conditions":[{"id":"5fb962b2-164c-4129-99d0-7c3fcc68985a","leftValue":"={{ $json.callClaude === true }}","rightValue":"","operator":{"type":"boolean","operation":"true","singleValue":true}}],"combinator":"and"},"options":{}},"id":"09896dac-af35-4277-b19e-6b131a76b9c7","name":"Fire Claude?","type":"n8n-nodes-base.if","typeVersion":2,"position":[960,0]},{"parameters":{"method":"POST","url":"={{ $('Factory Settings').first().json.claudeRoutineUrl }}","authentication":"genericCredentialType","genericAuthType":"httpHeaderAuth","sendHeaders":true,"headerParameters":{"parameters":[{"name":"anthropic-version","value":"2026-10-21"}]},"sendBody":true,"specifyBody":"json","jsonBody":"={{ { text: JSON.stringify($json.payload) } }}","options":{"redirect":{"redirect":{"followRedirects":false}},"timeout":15000}},"id":"92b5b717-4df9-43ab-8a96-d581a6d8696d","name":"Fire Claude Routine","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[1200,-96],"credentials":{"httpHeaderAuth":{"id":"EbZbO2zRt0RXWkfA","name":"Claude Routine"}}},{"parameters":{"chatId":"={{ $('Conversation Router').first().json.chatId }}","text":"={{ $('Conversation Router').first().json.reply }}","additionalFields":{"appendAttribution":false,"disable_web_page_preview":true}},"id":"bc93e259-2213-4c26-b9e6-9072a71be8d0","name":"Confirm Fired","type":"n8n-nodes-base.telegram","typeVersion":1.2,"position":[1440,-96],"webhookId":"cd2cc04b-b604-481f-a8c7-3fbd3c7f9460","credentials":{"telegramApi":{"id":"MOSawTRQa5BzV3pt","name":"Telegram account"}}},{"parameters":{"chatId":"={{ $json.chatId }}","text":"={{ $json.reply }}","additionalFields":{"appendAttribution":false,"disable_web_page_preview":true}},"id":"ca7d754b-d811-467a-a2d0-167aadd56cab","name":"Send Prompt / Help","type":"n8n-nodes-base.telegram","typeVersion":1.2,"position":[1200,96],"webhookId":"beacdede-b672-460f-8d49-98c4139bc2a3","crede