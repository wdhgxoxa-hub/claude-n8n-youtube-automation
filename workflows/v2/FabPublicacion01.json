      "position": [
        880,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst e = $json;\nconst extra = e.avisos.length ? '\\n\\nAvisos:\\n• ' + e.avisos.join('\\n• ') : '';\nconst cortes = (e.cortes || []).map(c => `\\n• Corte ${c.corte} (${Math.round(c.duracion_s)} s): ${c.url}`).join('');\nconst titulos = (e.publicacion?.youtube?.titulos || []).slice(0, 3).map((t, i) => `\\n${i + 1}. ${t}`).join('');\nreturn [{ json: { etapa: 'final', video_id: e.video_id, canal_id: e.canal_id,\n  contexto: { render_url: e.render_url, creditos: e.creditos || [], cortes: e.cortes || [], miniatura_url: e.miniatura_url || '', publicacion: e.publicacion || {}, formato: e.formato },\n  mensaje: (`Video ${e.video_id} listo (${Math.round(e.duracion_s)} s, ~US$${e.costo_usd}).\\nRevísalo: ${e.render_url}` + (e.miniatura_url ? `\\nMiniatura: ${e.miniatura_url}` : '')\n    + (cortes ? `\\nCortes verticales:${cortes}` : '') + (titulos ? `\\nTítulos propuestos:${titulos}` : '')\n    + `\\nCarpeta: https://drive.google.com/drive/folders/${e.carpeta}${extra}\\n\\n¿Lo apruebo para publicarlo?`).slice(0, 3900) } }];\n"
      },
