    {
      "parameters": {
        "jsCode": "\nconst l = $('Radar del canal').all().map(i => i.json);\nconst t = l.map(c => { if (!c.ok) return `• ${c.nombre}: sin radar hoy (vidIQ o el analista no respondieron).`;\n  const r = JSON.parse(c.tendencias);\n  return `${c.nombre}\\n${r.resumen}\\n` + r.ideas.map((x, i) => `${i + 1}. [${x.red}] ${x.titulo}\\n   ${x.gancho}`).join('\\n')\n    + (r.sonidos.length ? '\\nSonidos en alza en TikTok (para publicar a mano; la publicación automática no los agrega): ' + r.sonidos.map(s => s.nombre).join(' · ') : ''); }).join('\\n\\n');\nreturn [{ json: { texto: ('📡 Radar de tendencias\\n\\n' + t + '\\n\\nLa fábrica las usará en los próximos guiones. Para pedir una: «haz un video de la idea 2 de Margen Real».').slice(0, 3900) } }];\n"
      },
