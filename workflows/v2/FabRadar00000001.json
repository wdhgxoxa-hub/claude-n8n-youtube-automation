    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/responses",
        "options": {
          "timeout": 180000
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { model: $('Leer ajustes').first().json.modeloCritico, text: { format: { type: 'json_object' } }, input: [{ role: 'user', content: [{ type: 'input_text', text: $json.prompt }] }] } }}"
      },
      "id": "fa9e9c50-369a-4770-9adf-23194883a05e",
      "name": "Analista de tendencias",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1980,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "FabCredOpenAI001",
          "name": "OpenAI"
        }
      },
      "onError": "continueRegularOutput",
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "jsCode": "\nconst enc = $('Encargo del analista').all().map(i => i.json); const hoy = new Date().toISOString();\nreturn $input.all().map((i, k) => { const p = enc[k] || {}; let r = {};\n  try { r = JSON.parse((i.json.output || []).flatMap(o => o.content || []).find(x => x.type === 'output_text')?.text || '{}'); } catch (x) { r = {}; }\n  const ideas = (r.ideas || []).slice(0, 5); const ok = ideas.length > 0;\n  return { json: { canal_id: p.canal_id, nombre: p.nombre, ok, creditos: p.creditos,\n    tendencias: ok ? JSON.stringify({ fecha: hoy, resumen: String(r.resumen || '').slice(0, 600), formatos: (r.formatos || []).slice(0, 3), ideas, sonidos: (r.sonidos || []).slice(0, 3) }) : '' } }; });\n"
      },
