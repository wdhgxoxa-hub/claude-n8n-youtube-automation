        440,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "\nif ($env.COOPER_MARCAS_HABILITAR !== '1') return [];\nconst accion = \"publicar\";\nconst secret = $env.COOPER_MARCAS_WORKER_SECRET || '';\nif (secret.length < 32) throw new Error('Configurar el secreto dedicado de Marcas');\nconst origin = String($env.COOPER_MARCAS_URL || '').replace(/\\/$/, '');\nif (!/^https:\\/\\/[a-z0-9.-]+(?::\\d+)?$/i.test(origin)) throw new Error('Configurar origen HTTPS de Cooper');\nconst cuerpo = JSON.stringify({accion}), tiempo = String(Date.now());\nconst firma = require('crypto').createHmac('sha256', secret).update(tiempo + '.' + cuerpo).digest('hex');\nreturn [{json:{url:origin + '/api/marcas/operar', cuerpo, tiempo, firma}}];\n"
      },
      "id": "9841b27d-4628-5431-bce1-b4f48491c892",
      "name": "Firmar trabajo de marcas",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.url }}",
        "options": {
          "timeout": 210000,
          "batching": {
            "batch": {
              "batchSize": 1,
              "batchInterval": 1100
            }
          }
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-cooper-time",
              "value": "={{ $json.tiempo }}"
            },
            {
              "name": "x-cooper-signature",
              "value": "={{ $json.firma }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json.cuerpo }}"
      },
      "id": "1ba36f8c-7623-5b65-a91c-020756dacc3e",
