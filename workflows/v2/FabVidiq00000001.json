    {
      "parameters": {
        "jsCode": "\nconst e = $('Inicio').first().json;\nconst t = (e.titulos || []).map(x => String(x || '').trim()).filter(Boolean).filter((x, i, a) => a.indexOf(x) === i).slice(0, 4);\nreturn t.length ? t.map(titulo => ({ json: { titulo: titulo.slice(0, 200), tipo: e.formato === 'short' ? 'short' : 'long' } })) : [{ json: { vacio: true } }];\n"
      },
