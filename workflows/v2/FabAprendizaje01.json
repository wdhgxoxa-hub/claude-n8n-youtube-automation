        0
      ]
    },
    {
      "parameters": {
        "jsCode": "\n// Media de la curva (audienceWatchRatio por tramo) ≈ porcentaje medio visto. La usa el freno de calidad de la rutina.\nconst yt = $('Pedidos de retención').all().map(i => i.json);\nreturn $input.all().map((i, k) => { const rows = i.json.rows || []; const v = yt[k] || {};\n  const m = rows.length ? rows.reduce((a, r) => a + Math.min(1.5, Number(r[1]) || 0), 0) / rows.length : null;\n  return { json: { video_id: v.video_id, retencion_media: m === null ? null : Math.round(Math.min(1, m) * 1000) / 1000 } }; })\n  .filter(x => x.json.video_id && x.json.retencion_media !== null);\n"
      },
