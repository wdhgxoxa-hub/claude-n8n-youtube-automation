        440,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "\nif ($env.COOPER_MARCAS_HABILITAR !== '1') return [];\nconst accion = \"metricas\";\nconst secret = $env.COOPER_MARCAS_WORKER_SECRET || '';\nif (secret.length < 32) throw new Error('Configurar el secreto dedicado de Marcas');\nconst origin = String($env.COOPER_MARCAS_URL || '').replace(/\\/$/, '');\nif (!/^https:\\/\\/[a-z0-9.-]+(?::\\d+)?$/i.test(origin)) throw new Error('Configurar origen HTTPS de Cooper');\nconst cuerpo = JSON.stringify({accion}), tiempo = String(Date.now());\nconst firma = require('crypto').createHmac('sha256', secret).update(tiempo + '.' + cuerpo).digest('hex');\nreturn [{json:{url:origin + '/api/marcas/operar', cuerpo, tiempo, firma}}];\n"
      },
      "id": "cf204d45-6e09-5789-a20b-71204a36ea3a",
      "name": "Firmar trabajo de marcas",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.url }}",
        "options": {
          "timeout": 300000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-cooper-time",
              "value": "={{ $json.tiempo }}"
            },
            {
              "name": "x-cooper-signature",
              "value": "={{ $json.firma }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json.cuerpo }}"
      },
      "id": "f0c2ab63-7b53-51f2-96e9-ee71fa2c74f7",
