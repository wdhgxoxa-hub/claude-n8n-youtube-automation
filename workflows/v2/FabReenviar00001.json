      "position": [
        2860,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "\nif (!$('Diagnóstico').isExecuted) return [{ json: { texto: 'No hay aprobaciones pendientes' + ($('Inicio').first().json.video_id ? ' de ' + $('Inicio').first().json.video_id : '') + '.' } }];\nconst d = $('Diagnóstico').all().map(i => i.json); const nombre = r => `${r.etapa}${r.video_id ? ' · ' + r.video_id : ''}`;\nconst l = [];\nconst vivos = d.filter(r => r.vivo), rehechos = d.filter(r => r.rehacer), perdidos = d.filter(r => !r.vivo && !r.rehacer);\nif (vivos.length) l.push('Reenviadas con su mismo enlace: ' + vivos.map(r => `${nombre(r)} (${r.url})`).join('; '));\nif (rehechos.length) l.push('Enlace muerto, rehechas con enlace nuevo (llega en un momento): ' + rehechos.map(nombre).join(', '));\nif (perdidos.length) l.push('No se pueden rehacer (su proceso se detuvo; pide «corregir» o crea el video de nuevo): ' + perdidos.map(nombre).join(', '));\nreturn [{ json: { texto: l.join('\\n') } }];\n"
      },
