      "id": "c879017c-1883-4bac-a356-b5d23c9f0d3d",
      "name": "Probar enlace",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1320,
        0
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "\n// Vivo = el formulario todavía se puede llenar (200 con <form>). Respondido, detenido o firma rota (401) = muerto.\nconst filas = $('Elegir').all().map(i => i.json);\nreturn $input.all().map((it, k) => { const r = filas[k]; const cuerpo = String(it.json.data ?? it.json.body ?? '');\n  const vivo = Number(it.json.statusCode) === 200 && /<form/i.test(cuerpo);\n  const rehacer = !vivo && !!r.pedido;\n  return { json: { ...r, vivo, rehacer, salida: vivo ? 0 : rehacer ? 1 : 2 } }; });\n"
      },
      "id": "fffbdb90-7657-43ba-a49b-edb095a9a62a",
