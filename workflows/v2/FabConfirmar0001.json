      "id": "a77c5db6-5519-4259-8bc2-9566c57b3033",
      "name": "Publicaciones recientes",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        660,
        0
      ],
      "alwaysOutputData": true,
      "executeOnce": true
    },
    {
      "parameters": {
        "jsCode": "\n// Solo lo que ya debió salir (10 min de margen) y aún no está confirmado.\nconst corte = Date.now() - 10 * 60000;\nconst l = $input.all().map(i => i.json).filter(p => p.request_id && ['programado', 'enviado'].includes(p.estado) && Date.parse(p.publicado_en || 0) <= corte);\nreturn l.length ? l.map(p => ({ json: p })) : [{ json: { nada: true } }];\n"
      },
      "id": "ea20b38c-055f-4451-a775-f1414158788d",
      "name": "Por confirmar",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "cd7c399d-6032-49eb-8c89-568f8ac7b254",
              "leftValue": "={{ $json.nada !== true }}",
              "rightValue": "",
