    {
      "parameters": {
        "jsCode": "\n// Solo lo que ya debió salir (10 min de margen) y aún no está confirmado.\nconst corte = Date.now() - 10 * 60000;\nconst filtroCooper=$('Consulta de Cooper').isExecuted ? $('Consulta de Cooper').first().json.video_id : '';\nconst l = $input.all().map(i => i.json).filter(p => p.request_id && (filtroCooper ? p.video_id===filtroCooper : ['programado', 'enviado'].includes(p.estado) && Date.parse(p.publicado_en || 0) <= corte));\nconst elegidas=filtroCooper?l.filter(p=>p.video_id===filtroCooper):l;\nreturn elegidas.length ? elegidas.map(p => ({ json: p })) : [{ json: { nada: true } }];\n"
      },
