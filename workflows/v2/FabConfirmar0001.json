      "name": "¿Hay por confirmar?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1100,
        0
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ 'https://api.upload-post.com/api/uploadposts/status?' + ($json.job_id ? 'job_id=' + encodeURIComponent($json.job_id) : 'request_id=' + encodeURIComponent($json.request_id)) }}",
        "options": {
          "timeout": 30000
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "id": "a4d86da4-ec79-40eb-a5e2-715dba1d58bc",
      "name": "Consultar Upload-Post",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1320,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "PpoAcczNUlZgLCwe",
          "name": "Upload-Post"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "\n// Traduce la respuesta de Upload-Post: completo y sin fallos → publicado; fallido → error; lo demás sigue esperando.\nconst pedidos = $('Por confirmar').all().map(i => i.json);\nconst todas = $('Publicaciones recientes').all().map(i => i.json);\nconst cambios = [];\n$input.all().forEach((it, k) => {\n  const p = pedidos[k]; const r = it.json || {}; if (!p) return;\n  const res = Array.isArray(r.results) ? r.results : [];\n  const st = String(r.status || '').toLowerCase();\n  // Solo se juzga lo terminado: mientras está «queued» Upload-Post ya trae success:false (aún no hay intento).\n  if (!['completed', 'failed'].includes(st) || !res.length) return;   // pendiente o en proceso: se mira en una hora\n  const fallo = st === 'failed' || res.some(x => x.success !== true);\n  const listo = !fallo;\n  const urls = res.map(x => x.post_url || x.url || '').filter(Boolean);\n  const errores = res.filter(x => x.success !== true).map(x => `${x.platform}: ${String(x.error_message || x.error || x.message || 'error').slice(0, 120)}`);\n  cambios.push({ request_id: p.request_id, video_id: p.video_id, plataformas: p.plataformas, tipo: p.tipo,\n    estado: listo ? 'publicado' : 'error', url: urls[0] || '', youtube_id: (res.find(x => x.platform === 'youtube' && x.success === true) || {}).platform_post_id || '',\n    resultado: JSON.stringify(listo ? { status: st, urls } : { status: st || 'failed', errores }).slice(0, 800) });\n});\nif (!cambios.length) return [{ json: { nada: true } }];\n// Estado del video: publicado cuando todas sus publicaciones salieron; error si alguna falló.\nconst porVideo = {};\nfor (const v of new Set(cambios.map(c => c.video_id))) {\n  const filas = todas.filter(t => t.video_id === v).map(t => cambios.find(c => c.request_id === t.request_id) || t);\n  const yt = cambios.filter(c => c.video_id === v && /youtube/.test(c.plataformas)).map(c => c.youtube_id || (c.url.match(/(?:v=|shorts\\/|youtu\\.be\\/)([\\w-]{11})/) || [])[1]).find(Boolean) || '';\n  porVideo[v] = { video_id: v, youtube_id: yt,\n    estado: filas.some(f => f.estado === 'error') ? 'error_publicacion' : filas.every(f => f.estado === 'publicado') ? 'publicado' : '' };\n}\nreturn cambios.map(c => ({ json: { ...c, video: porVideo[c.video_id] } }));\n"
      },
