    {
      "parameters": {
        "jsCode": "\nconst l = $('Leer resultados').all().map(i => i.json).map(c => c.estado === 'publicado'\n  ? `✅ ${c.video_id} → ${c.plataformas}${c.url ? '\\n' + c.url : ''}` : `❌ ${c.video_id} → ${c.plataformas}: ${JSON.parse(c.resultado).errores?.join('; ') || 'falló'}`);\nreturn [{ json: { texto: 'Publicación confirmada:\\n' + l.join('\\n') } }];\n"
      },
