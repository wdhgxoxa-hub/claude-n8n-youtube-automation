        "jsonBody": "={{ JSON.stringify({ jsonrpc: '2.0', id: 4, method: 'tools/call', params: { name: 'SearchSoundEffects', arguments: { query: { term: $json.termino }, first: 5 } } }) }}"
      },
      "id": "284369c3-adfe-4124-ab56-128e6bf59c4f",
      "name": "Buscar efecto",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        4840,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "FabCredEpidemic1",
          "name": "Epidemic Sound"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 4000,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const sse = t => { const d = String(t || '').split('\\n').filter(l => l.startsWith('data:')).map(l => l.slice(5).trim()); return d.length ? d[d.length - 1] : String(t || ''); };\nconst datos = t => { const m = JSON.parse(sse(t)); const d = JSON.parse((m.result?.content || []).find(c => c.type === 'text')?.text || '{}'); if (d.errors?.length) throw new Error('Epidemic: ' + d.errors[0].message); return Object.values(d.data || {})[0]; };\n\n// Por cada efecto pedido, el primero de 1 a 15 s.\nreturn $input.all().map((it, i) => {\n  const pedido = $('Efectos pedidos').all()[i]?.json || {};\n  let nodos = []; try { nodos = ((datos(it.json.data) || {}).nodes || []).map(n => n.soundEffect).filter(Boolean); } catch (err) { nodos = []; }\n  const fx = nodos.find(x => { const ms = x.audioFile?.durationInMilliseconds || 0; return ms >= 1000 && ms <= 15000; }) || nodos[0];\n  return { json: { plano: pedido.plano, termino: pedido.termino, id: fx?.id || '', titulo: fx?.title || '', duracion_s: fx ? Math.round(fx.audioFile.durationInMilliseconds / 100) / 10 : 0 } };\n});\n"
      },
      "id": "c6eef07e-6580-414b-96ff-db600575b3fc",
