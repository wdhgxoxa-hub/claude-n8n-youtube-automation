      "id": "025e63a1-4758-4eff-87d2-59b5a5ef2194",
      "name": "Leer ajustes",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "\n// Un ítem por plano con su texto narrable y la dirección de actuación.\nconst e = $('Inicio').first().json; const aj = $('Leer ajustes').first().json;\nconst b = e.biblia || {}; const voz = b.voz || {};\nconst base = [voz.descripcion, voz.tono, voz.ritmo].filter(Boolean).join('. ') || 'narrador de documental, voz grave y cercana';\nconst MARCAS = { 'énfasis': 'remarca con intensidad', 'enfasis': 'remarca con intensidad', 'susurro': 'en voz baja, casi un susurro',\n  'suspenso': 'con suspenso contenido', 'pausa': '' };\nconst planos = (e.planos || []).filter(p => p.plano?.texto_narrado);\nreturn planos.map(p => {\n  const t = String(p.plano.texto_narrado);\n  const marcas = [...t.matchAll(/\\[([^\\]]{1,30})\\]/g)].map(m => MARCAS[m[1].toLowerCase()]).filter(Boolean);\n  const limpio = t.replace(/\\[pausa\\]/gi, '… ').replace(/\\[[^\\]]{1,30}\\]/g, '').replace(/\\s{2,}/g, ' ').trim();\n  const direccion = [base, p.plano.emocion ? 'emoción: ' + p.plano.emocion : '', ...marcas].filter(Boolean).join('; ');\n  return { json: { video_id: e.video_id, plano_id: p.plano_id, texto: limpio,\n    prompt: `Narra en ${b.idioma || 'español latino neutro'}. Dirección: ${direccion}. Lee exactamente este texto, sin añadir nada:\\n${limpio}`,\n    voz: voz.gemini_voice || aj.vozGemini } };\n});\n"
      },
      "id": "1acf4f73-0f41-4d40-9b81-506001dba8d5",
      "name": "Textos de voz",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ 'https://generativelanguage.googleapis.com/v1beta/models/' + $('Leer ajustes').first().json.modeloVoz + ':generateContent' }}",
        "options": {
          "timeout": 180000
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { contents: [{ parts: [{ text: $json.prompt }] }], generationConfig: { responseModalities: ['AUDIO'], speechConfig: { voiceConfig: { prebuiltVoiceConfig: { voiceName: $json.voz } } } } } }}"
      },
      "id": "2d03c9a7-8623-4310-9d18-06eb4eac0f3b",
      "name": "Voz (Gemini TTS)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "FabCredGemini001",
          "name": "Gemini (Veo)"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "jsCode": "\n// Gemini entrega PCM 16 bits mono 24 kHz: se le pone cabecera WAV y se mide la duración exacta.\nconst prev = $('Textos de voz').item.json;\nconst part = ($json.candidates?.[0]?.content?.parts || []).find(x => x.inlineData?.data);\nif (!part) throw new Error('Gemini TTS no devolvió audio para ' + prev.plano_id);\nconst rate = Number((part.inlineData.mimeType || '').match(/rate=(\\d+)/)?.[1] || 24000);\nconst pcm = Buffer.from(part.inlineData.data, 'base64');\nconst h = Buffer.alloc(44);\nh.write('RIFF', 0); h.writeUInt32LE(36 + pcm.length, 4); h.write('WAVE', 8); h.write('fmt ', 12);\nh.writeUInt32LE(16, 16); h.writeUInt16LE(1, 20); h.writeUInt16LE(1, 22); h.writeUInt32LE(rate, 24);\nh.writeUInt32LE(rate * 2, 28); h.writeUInt16LE(2, 32); h.writeUInt16LE(16, 34); h.write('data', 36); h.writeUInt32LE(pcm.length, 40);\nconst wav = Buffer.concat([h, pcm]);\nreturn [{ json: { ...prev, duracion_s: Math.round(pcm.length / (rate * 2) * 100) / 100 },\n  binary: { archivo: { data: wav.toString('base64'), mimeType: 'audio/wav', fileName: prev.plano_id + '.wav' } } }];\n"
      },
