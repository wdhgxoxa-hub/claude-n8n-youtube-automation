        "jsonBody": "={{ JSON.stringify({ jsonrpc: '2.0', id: 2, method: 'tools/call', params: { name: 'SearchRecordings', arguments: { query: { term: $json.termino }, first: 15 } } }) }}"
      },
      "id": "ea1b4a87-da4d-4cb9-b424-f089f9b06277",
