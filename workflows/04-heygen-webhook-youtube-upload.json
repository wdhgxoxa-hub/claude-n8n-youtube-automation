    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\nif (data.httpStatus) return [{ json: data }];\n\nconst allowedMedia = /^https:\\/\\/(?:files[0-9]*|resource)\\.heygen\\.ai\\/[^\\s\\\\#]+$/i;\nif (data.event === 'video_agent.success' && (typeof data.video_url !== 'string' || !allowedMedia.test(data.video_url))) {\n  return [{ json: { httpStatus: 422, receipt: 'unsupported_render_url' } }];\n}\nif (!/^[A-Za-z0-9_-]{20,}$/.test(data.spreadsheetId) || data.spreadsheetId.startsWith('__YOUR_')) {\n  return [{ json: { httpStatus: 503, receipt: 'spreadsheet_not_configured' } }];\n}\nreturn [{ json: data }];"
      },
