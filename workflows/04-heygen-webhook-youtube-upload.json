    {
      "parameters": {
        "jsCode": "const event = $('Resolve Render URL?').first().json;\nconst video = $input.first().json.data ?? {};\nif (video.id !== event.video_id || video.status !== 'completed' || !video.video_url) {\n  return [{ json: { httpStatus: 503, receipt: 'render_url_unavailable' } }];\n}\nreturn [{ json: { ...event, video_url: video.video_url } }];"
