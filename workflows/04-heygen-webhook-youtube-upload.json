    {
      "parameters": {
        "jsCode": "const { headers, body, expectedSignature } = $input.first().json;\nconst signature = headers?.signature;\nconst respond = (httpStatus, receipt) => [{ json: { httpStatus, receipt } }];\nif (typeof signature !== 'string' || !/^[a-fA-F0-9]{64}$/.test(signature)\n    || typeof expectedSignature !== 'string' || expectedSignature.length !== 64) {\n  return respond(401, 'invalid_signature');\n}\n\n// Compare equal-length hex digests without a data-dependent early exit.\nconst actual = signature.toLowerCase();\nlet difference = 0;\nfor (let index = 0; index < 64; index++) {\n  difference |= actual.charCodeAt(index) ^ expectedSignature.charCodeAt(index);\n}\nif (difference !== 0) return respond(401, 'invalid_signature');\n\nconst event = body?.event_type;\nif (typeof event !== 'string') return respond(400, 'invalid_event');\nif (!['video_agent.success', 'video_agent.fail'].includes(event)) return respond(200, 'event_ignored');\n\nconst data = body.event_data ?? {};\nconst readId = (value) => typeof value === 'string' && /^[A-Za-z0-9_-]{1,128}$/.test(value) ? value : '';\nconst videoId = readId(data.video_id);\nconst sessionId = readId(data.session_id);\nif (!videoId && !sessionId) return respond(400, 'missing_render_id');\n\nreturn [{ json: {\n  event,\n  video_id: videoId,\n  sessionId,\n  video_url: data.video_url || data.url || '',\n} }];"
      },
