    {
      "parameters": {
        "jsCode": "const event = $('Validate Render').first().json;\nconst matches = $input.all().filter(({ json }) => json.video_id === event.video_id);\nconst respond = (httpStatus, receipt) => [{ json: { httpStatus, receipt } }];\nif (matches.length === 0) return respond(503, 'video_not_registered');\nif (matches.length > 1) return respond(409, 'duplicate_video_id');\n\nconst row = matches[0].json;\nif (row.youtube_url || ['uploading', 'uploaded', 'published', 'failed'].includes(row.status)) {\n  return respond(200, 'already_handled');\n}\nif (!['generating', 'ready'].includes(row.status)) return respond(409, 'unknown_video_status');\n\nconst success = event.event === 'video_agent.success';\nif (!success && row.status === 'ready') return respond(200, 'already_handled');\nif (success && row.status === 'ready' && event.allowYoutubeUpload !== true) return respond(200, 'already_handled');\n\nlet status = success ? 'ready' : 'failed';\nif (success && event.allowYoutubeUpload === true) {\n  if (typeof row.title !== 'string' || !row.title.trim() || row.title.length > 100 || /[<>]/.test(row.title)\n      || typeof row.description !== 'string' || Buffer.byteLength(row.description, 'utf8') > 5000 || /[<>]/.test(row.description)) {\n    return respond(422, 'invalid_youtube_metadata');\n  }\n  status = 'uploading';\n}\nreturn [{ json: {\n  update: true,\n  video_id: event.video_id,\n  video_url: success ? event.video_url : (row.video_url || ''),\n  title: row.title,\n  description: row.description,\n  status,\n} }];"
      },
