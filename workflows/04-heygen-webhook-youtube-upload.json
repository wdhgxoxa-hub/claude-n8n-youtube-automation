      "id": "412f1ef7-3dec-4a38-8e1c-84231f6277a3",
      "name": "Calculate HeyGen Signature",
      "type": "n8n-nodes-base.crypto",
      "typeVersion": 2,
      "position": [
        240,
        0
      ]
