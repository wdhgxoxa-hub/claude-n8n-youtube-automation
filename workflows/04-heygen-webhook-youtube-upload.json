    {
      "parameters": {
        "jsCode": "const item = $input.first();\nconst file = await this.helpers.getBinaryDataBuffer(0, 'data');\nif (file.length < 16 || file.toString('ascii', 4, 8) !== 'ftyp') {\n  throw new Error('HeyGen did not return an MP4 file.');\n}\nitem.binary.data = await this.helpers.prepareBinaryData(file, 'video.mp4', 'video/mp4');\nreturn [item];"
