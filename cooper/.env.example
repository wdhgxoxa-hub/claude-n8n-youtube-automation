# Copiar a .env.local. Las sesiones de ensayo solo existen en el ejecutor E2E separado.
AUTH_SECRET=generar-con-openssl-rand-base64-32
AUTH_URL=http://localhost:3000
# Activa solo tras un proxy que controles. En local Auth.js detecta el host.
# AUTH_TRUST_HOST=true
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
COOPER_ADMIN_EMAIL=walter@example.com
COOPER_DATABASE_PATH=./data/cooper.sqlite
COOPER_FABRICA=simulada
COOPER_SIMULACION_MS=8000
COOPER_N8N_URL=http://localhost:5678/webhook/cooper/v1
COOPER_N8N_TOKEN=
COOPER_GASTO_ALERTA_USD=25
NEXT_TELEMETRY_DISABLED=1

# Demostración: base separada (sufijo .demo), 2 canales y 4 videos por cuenta.
COOPER_DEMO=0
# Solo servidor: mismo secreto aleatorio (mínimo 32 caracteres) en Cooper y n8n.
COOPER_WEBHOOK_SECRET=
# Medios: simulada por defecto. Configurar solo en servidor, nunca NEXT_PUBLIC_*.
COOPER_AVATAR=simulada
# Opciones: simulada | heygen | elevenlabs. No hay cambio automático de proveedor.
COOPER_VOZ_CLONADA=simulada
# Opciones: simulada | gemini.
COOPER_VOZ_CATALOGO=simulada
COOPER_TRANSCRIPCION=simulada
HEYGEN_API_KEY=
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
# Mantener alineado con Ajustes.modeloVoz en tools/generar_flujos_v2.py.
COOPER_GEMINI_TTS_MODEL=gemini-3.8-flash-tts
COOPER_GEMINI_TRANSCRIPCION_MODEL=gemini-4-hydrogen

# WhatsApp: simulada | whatsapp. Demo siempre fuerza simulada.
COOPER_MENSAJERIA=simulada
# 1 pausa el consumidor al arrancar; 0 procesa cada 15 s sin navegador abierto.
COOPER_MENSAJERIA_PAUSA=0
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
