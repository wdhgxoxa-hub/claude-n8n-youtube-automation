# Copiar a .env.local. Las sesiones de ensayo solo existen en el ejecutor E2E separado.
AUTH_SECRET=generar-con-openssl-rand-base64-32
AUTH_URL=http://localhost:3000
# Activa solo tras un proxy que controles. En local Auth.js detecta el host.
# AUTH_TRUST_HOST=true
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
COOPER_ADMIN_EMAIL=walter@example.com
COOPER_DATABASE_PATH=./data/cooper.sqlite
COOPER_FABRICA=simulada
COOPER_SIMULACION_MS=8000
COOPER_N8N_URL=http://localhost:5678/webhook/cooper/v1
COOPER_N8N_TOKEN=
COOPER_GASTO_ALERTA_USD=25
# Salud operativa: lecturas administrativas; no reutilizar el token del webhook.
COOPER_N8N_API_URL=
COOPER_N8N_API_KEY=
COOPER_OBSERVABILIDAD_VPS_PATH=
# Telegram se activa además desde Salud operativa; solo servidor, sin valores en la web.
COOPER_TELEGRAM_BOT_TOKEN=
COOPER_TELEGRAM_CHAT_ID=
COOPER_OBSERVABILIDAD_PAUSA=0
NEXT_TELEMETRY_DISABLED=1

# Demostración: base separada (sufijo .demo), 2 canales y 4 videos por cuenta.
COOPER_DEMO=0
# Solo servidor: mismo secreto aleatorio (mínimo 32 caracteres) en Cooper y n8n.
COOPER_WEBHOOK_SECRET=
# Medios: simulada por defecto. Configurar solo en servidor, nunca NEXT_PUBLIC_*.
COOPER_AVATAR=simulada
# Opciones: simulada | heygen | elevenlabs. No hay cambio automático de proveedor.
COOPER_VOZ_CLONADA=simulada
# Opciones: simulada | gemini.
COOPER_VOZ_CATALOGO=simulada
COOPER_TRANSCRIPCION=simulada
HEYGEN_API_KEY=
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
# Mantener alineado con Ajustes.modeloVoz en tools/generar_flujos_v2.py.
COOPER_GEMINI_TTS_MODEL=gemini-3.8-flash-tts
COOPER_GEMINI_TRANSCRIPCION_MODEL=gemini-4-hydrogen

# Chat: auto | claude-cli | codex-local | claude (API) | openai (API) | simulada.
# Solo servidor; demo y ejecutores de pruebas fuerzan simulada.
COOPER_CHAT=auto
# auto/claude-cli: Claude Code con sesión → puente Codex → APIs con clave → básico.
# 0 impide el respaldo de pago aunque haya claves; no afecta los modos API explícitos.
COOPER_CHAT_API_RESPALDO=0
COOPER_CLAUDE_BIN=claude
PUENTE_CODEX_URL=http://127.0.0.1:8789
PUENTE_CODEX_TOKEN=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
COOPER_CHAT_MODELO_CLAUDE=claude-sonnet-5-5
COOPER_CHAT_MODELO_OPENAI=gpt-6.1-sol
# Para audio real con OpenAI: COOPER_TRANSCRIPCION=openai (modelo gpt-transcribe).
# WhatsApp: simulada | whatsapp. Demo siempre fuerza simulada.
COOPER_MENSAJERIA=simulada
# 1 pausa el consumidor al arrancar; 0 procesa cada 15 s sin navegador abierto.
COOPER_MENSAJERIA_PAUSA=0
# Pausa solo el seguimiento de avatares/voces; no reenvía creaciones.
COOPER_BIBLIOTECA_PAUSA=0
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Administración de plantillas y suscripción del webhook; no es el ID del número.
WHATSAPP_WABA_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# Marcas: simulada por defecto; real requiere activos asignados por Walter.
COOPER_MARCAS=simulada
COOPER_META_GRAPH_VERSION=v27.0
COOPER_META_SYSTEM_TOKEN=
UPLOAD_POST_API_KEY=
# Secreto dedicado, al menos 32 caracteres. Solo Cooper y los flujos nuevos de n8n.
COOPER_MARCAS_WORKER_SECRET=
