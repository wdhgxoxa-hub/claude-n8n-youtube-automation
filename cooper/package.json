{
  "name": "cooper",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node scripts/e2e.mjs",
    "test:ensayo": "node --test ../tests/migrar_dueno.test.mjs && node scripts/ensayo.mjs",
    "db:migrate": "tsx src/db/migrar.ts",
    "datos:inventario": "tsx scripts/retencion.ts",
    "preparar:pruebas": "node scripts/preparar-pruebas.mjs",
    "preparar:sentinel": "node scripts/preparar-sentinel.mjs",
    "preflight": "node scripts/preflight.mjs",
    "ci:local": "node scripts/puerta.mjs",
    "ci:limpia": "node scripts/ci-limpia.mjs",
    "evaluar:chat": "tsx scripts/evaluar-chat.ts",
    "test:ensayo:total": "node scripts/ensayo-total.mjs",
    "test:ensayo:ramas": "node scripts/ensayo-total.mjs --ramas"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.2.8",
    "better-sqlite3": "^13.2.0",
    "drizzle-orm": "^0.45.4",
    "framer-motion": "^12.23.24",
    "lottie-web": "5.13.0",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "next-auth": "5.0.0-beta.32",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "0.35.5",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@next/eslint-plugin-next": "^16.4.6",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4.1.17",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "gremlins.js": "2.2.0",
    "lighthouse": "^13.6.0",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.1.17",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^4.0.8"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "allowScripts": {
    "esbuild": true,
    "better-sqlite3": true,
    "core-js": false
  }
}
