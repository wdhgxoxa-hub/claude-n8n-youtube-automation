# Herramientas de ensayo, sin código ni configuración de producción.
FROM ghcr.io/astral-sh/uv:0.12.24@sha256:3af4716e991d6956a41e573eab705d0ee08500cd829ed30293eb8472f372c65a AS uv
FROM docker.io/library/node:24.22.3-bookworm-slim@sha256:0e2646ab57e77b7a384a0cb59b6815b182c77e1f9c3ba36bd8435bd9c4e6680e
COPY --from=uv /uv /usr/local/bin/uv
ENV UV_PYTHON_INSTALL_DIR=/opt/python PYTHONDONTWRITEBYTECODE=1 NEXT_TELEMETRY_DISABLED=1
RUN uv python install 3.14.7 && ln -s "$(uv python find 3.14.7)" /usr/local/bin/python3
COPY sentinel-requirements.txt /opt/sentinel-requirements.txt
RUN uv venv --python 3.14.7 /opt/sentinel-deps && uv pip sync --python /opt/sentinel-deps/bin/python --require-hashes --only-binary :all: /opt/sentinel-requirements.txt
# Dependencias de SO oficiales de Playwright; solo dentro de la imagen local.
ARG DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends build-essential ffmpeg ca-certificates && /opt/sentinel-deps/bin/python -m playwright install-deps chromium
RUN npm install --global npm@12.2.2 --no-fund --update-notifier=false
# Playwright JS coincide con package-lock.json; bibliotecas solo en la imagen local.
RUN npx --yes --package=playwright@1.65.1 playwright install-deps firefox webkit
# Las regresiones de la caché crean repositorios Git ficticios dentro del ensayo.
RUN apt-get update && apt-get install -y --no-install-recommends git && rm -r /var/lib/apt/lists/*
WORKDIR /ensayo/cooper
CMD ["node", "scripts/puerta.mjs"]
